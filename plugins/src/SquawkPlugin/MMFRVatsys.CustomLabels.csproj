<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MMFRVatsys.CustomLabels</AssemblyName>
    <RootNamespace>MMFRVatsys.CustomLabels</RootNamespace>
    <AssemblyTitle>MMFRVatsys.SquawkPlugin</AssemblyTitle>
    <Product>MMFRVatsys.SquawkPlugin</Product>
    <Copyright>Copyright (c) 2020</Copyright>
    <Version>1.1.0.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="vatSys">
      <HintPath>C:\Program Files (x86)\vatSys\bin\vatSys.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

</Project>
