    <!-- MARK: Bay Types -->
    <!-- Creates bays of various types for use in LayoutDefinitions above -->
    <BayTypes>
        <!-- RADAR TOWER / DEFAULT -->
        <BayType>
            <Bay Name="Preactive">
                <Type>BAY_PREA</Type>
            </Bay>
            <Bay Name="Cleared">
                <Type>BAY_CLEARED</Type>
            </Bay>
            <Bay Name="Pushback">
                <Type>BAY_PUSHED</Type>
            </Bay>
            <Bay Name="Taxi">
                <Type>BAY_TAXI</Type>
            </Bay>
            <Bay Name="Holding Point">
                <Type>BAY_HOLDSHORT</Type>
            </Bay>
            <Bay Name="Runway" CDMDisplay="true">
                <Type>BAY_RUNWAY</Type>
            </Bay>
            <Bay Name="Departed">
                <Type>BAY_OUT</Type>
                <Type>BAY_CIRCUIT</Type>
            </Bay>
            <Bay Name="Arrivals">
                <Type>BAY_ARRIVAL</Type>
            </Bay>
        </BayType>

        <!-- METROD -->
        <BayType Type="D">
            <Bay Name="Preactive">
                <Type>BAY_PREA</Type>
            </Bay>
            <Bay Name="Cleared">
                <Type>BAY_CLEARED</Type>
            </Bay>
            <Bay Name="Pushback">
                <Type>BAY_PUSHED</Type>
            </Bay>            
            <Bay Name="Taxi">
                <Type>BAY_TAXI</Type>
            </Bay>
            <Bay Name="Holding Point">
                <Type>BAY_HOLDSHORT</Type>
            </Bay>
            <Bay Name="Runway" CDMDisplay="true">
                <Type>BAY_RUNWAY</Type>
            </Bay>
            <Bay Name="Departed">
                <Type>BAY_OUT</Type>
                <Type>BAY_CIRCUIT</Type>
            </Bay>            
            <Bay Name="Arrivals">
                <Type>BAY_ARRIVAL</Type>
            </Bay>
        </BayType>

        <!-- PROC -->
        <BayType Type="Proc">
            <Bay Name="Preactive">
                <Type>BAY_PREA</Type>
            </Bay>
            <Bay Name="Cleared">
                <Type>BAY_CLEARED</Type>
            </Bay>
            <Bay Name="Taxi">
                <Type>BAY_TAXI</Type>
            </Bay>
            <Bay Name="Holding Point">
                <Type>BAY_HOLDSHORT</Type>
            </Bay>
            <Bay Name="Runway" CDMDisplay="true">
                <Type>BAY_RUNWAY</Type>
            </Bay>
            <Bay Name="Active">
                <Type>BAY_CIRCUIT</Type>
                <Type>BAY_OUT</Type>
            </Bay>
            <Bay Name="Pending Arrivals">
                <Type>BAY_ARRIVAL</Type>
            </Bay>
        </BayType>
    </BayTypes>


